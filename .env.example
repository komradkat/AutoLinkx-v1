APP_URL=http://localhost:3000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-publishable-key
# Server-only. Never expose through a NEXT_PUBLIC_ variable or a client bundle.
SUPABASE_SECRET_KEY=replace-with-local-service-role-or-secret-key
# ISO-4217; one currency per deployment. Final choice pending (MVP.md section 13).
MARKETPLACE_CURRENCY=EUR
# Private Storage bucket for listing photos.
LISTING_PHOTOS_BUCKET=listing-photos
LOG_LEVEL=info
# Local seed only; use unique passwords of at least 12 characters.
SEED_PASSWORD=
